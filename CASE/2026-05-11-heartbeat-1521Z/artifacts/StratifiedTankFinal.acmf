End
Model UTTSC
/* Model built based on
(1)   "All-glass vacuum tube collector heat transfer model used in forced-circulation solar water heating system"
      Zhiyong Li *, Chao Chen, Hailiang Luo, Ye Zhang, Yaning Xue*/

//Declaration of System Parameters
eps as RealParameter (description:"Proportion of hot water?s XA to the entire tube XA (1)->Fig4", lower:0,upper:1, value:0.5);
pi as RealParameter (description:"Pi", value:3.14);
r1 as Length (description:"Inner tube radius, m", value:0.0185, spec:Fixed);
r2 as Length (description:"Inner tube radius, m", value:0.0235, spec:Fixed);
a as Length (description:"Distance between adjacent tubes, m", value:0.01464, spec:Fixed);
y as RealVariable (description:"Thermal expansion coefficient, 1/K", value:0.0000081, spec:Fixed);
g as RealVariable (description:"Gravitational acceleration, m/s2", value:9.81, spec:Fixed);
TauAlphaTheta as RealVariable (description:"Product of transmittance s of outer tube and absorptance a of coating at prevailing incident angle", value:0.837, spec:Fixed);
w as Length (description:"Length of tube, m", value:1.8, spec:Fixed);
Beta as Angle (description:"Tilt angle of collector, Deg", value:0.96, spec:Fixed);
n as RealVariable (description:"Number of tubes", value:32, spec:Fixed);
A2 as RealVariable (description:"Area of Absorber Surface, M2", value:3, spec:Fixed);
MSpec as mass (description:"Mass charge of collector, kg", value:10, spec: Fixed);

// Declaration of variables;
Tam as temperature (description:"Ambient Temperature, C", value:30, spec:Fixed);
Ul as RealVariable (description:"Heat loss coefficient, W/(m2 C) (Found experimentally)", value:0.85, spec:Fixed);
DP as press_drop (description:"Pressure drop due to friction");
Mc as RealVariable (description:"Natural circulation mass flow rate, kg/s");
rho as dens_mass (description:"Mass density of components, kg/m3");
rhoMol as dens_mol_liq (description:"Liquid molar density, kmol/m3" );
rhoMolOut as dens_mol_liq (description:"Liquid molar density, kmol/m3" );
avgMM as molweight (description:"Average Molar weight, kg/kmol");
Mu as viscosity (description:"Kinematic viscosity, cP");
Cp as RealVariable (description:"Specific heat of water, J/(kg C)");
CpMol as cp_mol_liq (description:"Molar Specific Heat Capacity, KJ/Kmol/K");
M as mass (description:"Mass charge of collector, kg");
MFlow as flow_mass (description:"Mass Flow, kg/s");
Tp as temperature (description:"Mean temperatures of water in solar collector, C", value: 30);
Tm as temperature (description:"Mean temperatures of water in solar collector, C", value: 30, spec: fixed);
Tin as temperature (description:"Inlet Temperature");
Tout as temperature (description:"Outlet temperatures of water from solar collector, C");
k as RealVariable (description:"Defined coefficient");
ItoSpec as RealVariable (description:"Solar Insolation, W/M2", value:0.001, spec: Fixed);
Ito as RealVariable (description:"Solar Insolation, W/M2");
A1 as RealVariable (description:"Dissipation area of solar collector, m2");


// Declaration of ports
FO as output MoleFractionPort(Description:"Output port for heated fluid(Heated Side)");
FI as input MoleFractionPort(Description:"Input port for fluid to be heated  (Cold Side)");

//Collector Dimensions
A1=w*n*2*r1;
M=MSpec;

//Fluid Properties
//***************************************************
//Calculate Fluid Density
call (rhoMol) = pDens_Mol_Liq (FI.T, FI.P, FI.z);
call (avgMM) = pMolWeight (FI.z);
rho = rhoMol * avgMM; //Convert from kmol/m3 to kg/m3

//Calculate fluid viscosity
call (Mu) = pVisc_Liq (FI.T, FI.P, FI.z);

// Calculate Fluid mass specific heat capacity J/Kg K
call (CpMol) = pCp_Mol_Liq (FI.T, FI.P, FI.z);
Cp*avgMM-CpMol*1000=0; //Convert Cp from kJ/kmol.K to J/kg.C
//****************************************************

// Material balance relationships
//****************************************************
// Both Steady State and dynamic
//Total Molar Flow
FO.F=FI.F;

//Component Mole Fractions
for comps in ComponentList do
 FO.z(comps)=FI.z(comps);
endfor
//****************************************************

//****************************************************

//water mass charge of system, kg
//**********************

//MassFlow through the system
MFlow*3600-FI.F*avgMM=0; //Convert kmol/hr to kg/sec

//Outlet Pressure Calculation
FI.P - DP - FO.P=0;
DP*(r1*r1*pi*r1*r1*0.25)-2*Mu*0.001*w*MFlow*1e-5=0; //multiply by 1e-5 to convert from kPa to bars


//Outlet Temperature Calculatione
  (Tin+Tout)*Mflow-w*k*Mc+w*k*eps*Mflow-2*Tp*MFlow=0; //eqn 

  if itoSpec <= 0.01 then
    ito=0.00001;
  else
    ito=itoSpec;
  endif
  
  Tin=FI.T;
  Mc*sqrt((2*eps*pi*Mu*0.001*Cp))-eps*pi*r1*r1*rho*sqrt(y*g*Ito*TauAlphaTheta*r1*w*sin(Beta))=0; //eqn 19
  k*Mc*Cp-2*Ito*r1*TauAlphaTheta=0; //defined on pg 1417
  (M*Cp*$Tp-3600*(MFlow*Cp*(Tin-Tout)+Ito*TauAlphaTheta*A2-Ul*(Tp-Tam)*A1))*0.001=0; //Eqn 1
  FO.T=Tout;
  call (FO.h) = pEnth_Mol (FO.T, FO.P, FO.Z);
  call (rhoMolOut) = pDens_Mol_Liq (FO.T, FO.P, FO.z);;
  FO.V*rhoMolOut-1=0;
//****************************************************

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "UTTSCI";
TYPE UTTSC_T0 ROLE "ICON" text
Name = UTTSCI
lines = 28

sub main
call Path.Begin
'' <<Path:0
call Path.Box(-0.35,0.1,0.4,-0.3,0,0,1)
call Path.Box(-0.3,0.05,0.35,-0.25,0,0,1)
call Path.Box(-0.25,0.05,-0.2,-0.25,0,0,1)
call Path.Box(-0.15,0.05,-0.1,-0.25,0,0,1)
call Path.Text(0.1,-0.05,"Solar",0,"Times New Roman",0.0703812,0,0)
call Path.Text(0.1,-0.15,"Collector",0,"Times New Roman",0.0703812,0,0)
'' >>
call Path.End
end sub

sub LabPos
call Label.at(0.05,0.2)
end sub

sub ports
call Port.name("UniversalIN")
call Port.at(-0.348387,-0.102053)
call Port.direction(0)
call Port.name("UniversalOUT")
call Port.at(0.390616,-0.102053)
call Port.IOtype(1)
call Port.direction(0)
end sub



endtext

UTTSC_T0_I0 as UTTSC_T0;
