Version "27.0-0";
Libraries "Modeler.acml", "SystemLibrary.acml";
Model StartTank

//Solar Collector Loop
ToSC as output MaterialPort;
FromSC as input MaterialPort;
// <equation_name> : <expression1> = <expression2>;
ToSC.F = FromSC.F;
ToSC.P = FromSC.P;

// Call (<output argument list>) = <procedure name>(<input argument list>);
for comps in ComponentList do
 ToSC.z(comps)=FromSC.z(comps);
endfor

//Heat Exchanger Loop
ToHX as output MaterialPort;
FromHX as input MaterialPort;
// <equation_name> : <expression1> = <expression2>;
ToHX.F = FromHX.F;
ToHX.P = FromHX.P;

// Call (<output argument list>) = <procedure name>(<input argument list>);
for comps in ComponentList do
 ToHX.z(comps)=FromHX.z(comps);
endfor

//Single value variable declaration
B as RealParameter (description:"Thermal expansion coefficient, M3K-1", value:69e-6); 
g as RealParameter (description:"gravitational acceleration, m/s2", value:9.81);
Cp as RealParameter (description:"specific heat of water, J/(g C)", value: 4200);
Rmm as IntegerParameter (description:"Relative Molecular Mass of Fluid", value:18);
k as RealParameter (description:"Thermal Conductivity of fluid, W/(m.K)", value:0.58);
Mu as visc_liq (description: "Viscosity of fluid, Pa.s", value:0.00092, spec: Fixed);
hwall as heat_trans_coeff (description:"Wall Heat Transfer Coefficient (kW/m2/K", value:0.001, spec:Fixed);
D as LengthParameter (description:"Diameter of Tank, M", value:2);
H as LengthParameter (description:"Height of Tank,M", value:2);
Mn as RealVariable (description:"Net Mass Flow");
Fn as RealVariable (description:"Net Molar Flow");
Vn as RealVariable (description:"Net Velocity");
Tamb as temperature (description:"Ambient Temperature, C", value:30, spec:Fixed);
FromSCT as temperature;
FromHXT as temperature;
ToSCT as temperature;
ToHXT as temperature;
TBar as Temperature(description:"Bulk Temperaature of Tank", spec:Free);
rhoBar as Dens_Mass_Liq(description:"Bulk density of Tank", spec:Free);

FromSCT=FromSC.T;
FromHXT=FromHX.T;
//Setup Domains
Z as LengthDomain (HighestOrderDerivative:2, DiscretizationMethod:"BFD2", Length:H, SpacingPreference:0.05);

//Setup Distributions
Tnode as Distribution1D  of Temperature (XDomain is Z);
Vz as Distribution1D (XDomain is Z);

//Calculate rhoBar
AvgDensity: call(rhoBar)= pDens_Mass_Liq(TBar,FromSC.P,FromSC.z);

//Calculate TBar 
AvgTemperature: TBar=SIGMA(Tnode)/(Z.EndNode+1);

//Calculate Net Vz 
NetMolarFlow: Fn=(FromSC.F-FromHX.F); //Net Molar Flow down is positive
NetMassFlow: Mn=Rmm*Fn; //Net Mass Flow
NetVelocity: Vn=Mn/(0.7857*D^2*rhoBar); //Velocity at top and bottom of tank as net volumetric flow

MotionEquations:
rhoBar*($Vz(Z.Interior) + Vz(Z.Interior)*Vz(Z.Interior).ddx) - Mu*Vz(Z.Interior).d2dx2 + rhoBar*B*g*(Tnode(Z.Interior)-TBar) =0 ;
rhoBar*($Vz(Z.EndNode) + Vz(Z.EndNode)*Vz(Z.EndNode).ddx) + rhoBar*B*g*(Tnode(Z.EndNOde)-TBar) =0 ;


EnergyEquations:

rhoBar*Cp*(0.7857*D^2*Z.SpacingPreference*$Tnode(Z.Interior)+Vz(Z.Interior)*Tnode(Z.Interior).ddx) + k*Tnode(Z.Interior).d2dx2 + hwall*3.14*D*Z.SpacingPreference*(Tnode(Z.Interior)-Tamb) =0;


//Initial Conditions
Vz(Z.Interior+Z.EndNode):Vn;                                                 
Vz(Z.Interior+Z.EndNode):Initial;
Tnode([0]+Z.Interior+Z.EndNode):Tamb;
Tnode([0]+Z.Interior+Z.EndNode):Initial;

//BC
Vz([0])=Vn; //Velocity at top and bottom of tank as net volumetric flow

//Energy Balances on Top Node
rhoBar*Cp*(0.7857*D^2*Z.SpacingPreference*$Tnode(0))
= FromSC.F*Rmm*Cp*(FromScT-Tnode(0))+ToHX.F*Rmm*Cp*(Tnode(1)-ToHX.T);

//Energy Balance on Bottom Node
rhoBar*Cp*(0.7857*D^2*Z.SpacingPreference*$Tnode(Z.EndNode))
= FromSC.F*Rmm*Cp*(Tnode(Z.EndNode-1)-ToSC.T)+FromHX.F*Rmm*Cp*(FromHXT-Tnode(Z.EndNode));

//Grab Temperatures
ToSCT = Tnode([Z.EndNode]);
ToHXT = Tnode([0]);

//OUtlet Temperatures
ToSC.T = ToSCT;
ToHX.T = ToHXT;

call (ToSC.H) = pEnth_Mol (ToSC.T, ToSC.P, ToSC.z);
call (ToHX.H) = pEnth_Mol (ToHX.T, ToHX.P, ToHX.z);

ToSC.V=1/(rhoBar/Rmm);
ToHX.V=1/(rhoBar/Rmm);

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "System";
SystemData : Text
<FORMLIST DEFAULTFORM="AllVariables">
</FORMLIST>
<EXPORTDATA>AS::0::1
DISPLAY::StartTank
CATEGORY::ACM Models
GUID270::{088D3CD3-97A7-4B2B-B084-5A9C16172674}
PORT::FromHX::1::Mole Fraction::FromHX::0
PORT::ToHX::1::Mole Fraction::ToHX::0
PORT::FromSC::1::Mole Fraction::FromSC::0
PORT::ToSC::1::Mole Fraction::ToSC::0
QUERY::AllVariables::1::0::3</EXPORTDATA>
