ll, "is_mandatory": false}, {"name": "Source Title", "value": "Journal of Natural Gas Science and Engineering", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Source Title"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Volume", "value": "29", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Volume"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Issue", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Issue"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Start Page", "value": "125", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Start Page"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "End Page", "value": "133", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "End Page"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Article number", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Article number"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Chapter number", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Chapter number"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Editors", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Editors"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Editions", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Editions"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Series", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Series"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name":