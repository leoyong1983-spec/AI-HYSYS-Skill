International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The repository contains supplementary information of the paper titled: Role of biogenic CO2 in refienry decarbonization. A colombian refinery case study. The information includes  technoeconmic paramters of tehcnologies used, process data for cleaning, capture and processing CO2 modelled in Aspen Plus v12 and  Aspen Hysys V14 and system modelle in Linny-r. Information is presented in pdf file, linny-r model archive and  process simulation data is presented in the form of an Excel file, which includes details of the process, a process flow diagram, and mass and energy balance information.\n\n ","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"url":"https://zenodo.org/doi/10.5281/zenodo.15476366","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-20T13:10:08Z","registered":"2026-02-20T13:10:08Z","published":null,"updated":"2026-02-20T13:10:08Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}}}},{"id":"10.5281/zenodo.17101057","type":"dois","attributes":{"doi":"10.5281/zenodo.17101057","identifiers":[{"identifier":"oai:zenodo.org:17101057","identifierType":"oai"}],"creators":[{"name":"Efemena, Noble Aggrey","nameType":"Personal","givenName":"Noble Aggrey","familyName":"Efemena","affiliation":["Department of Gas Refining and Petrochemical Engineering, University of Port Harcourt, Nigeria"],"nameIdentifiers":[]},{"name":"Muwarure, Peter Odiboroghene","nameType":"Personal","givenName":"Peter Odiboroghene","familyName":"Muwarure","affiliation":["Department of Chemical Engineering, University of Port Harcourt, Nigeria"],"nameIdentifiers":[]}],"titles":[{"title":"Thermal Performance Optimization of Shell and Tube Heat Exchangers Using Simulation Based Design Enhancements"}],"publisher":"IJRESM","container":{},"publicationYear":2025,"subjects":[],"contributors":[],"dates":[{"date":"2025-09-08","dateType":"Issued"}],"language":null,"types":{"ris":"JOUR","bibtex":"article","citeproc":"article-journal","schemaOrg":"ScholarlyArticle","resourceType":"","resourceTypeGeneral":"JournalArticle"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.17101056","relatedIdentifierType":"DOI"},{"relationType":"IsPartOf","relatedIdentifier":"2581-5792","resourceTypeGeneral":"Collection","relatedIdentifierType":"ISSN"}],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Shell-and-tube heat exchangers are critical components in petrochemical processing, where efficient thermal exchange directly impacts energy consumption and product quality. This study investigates the thermal performance of a legacy heat exchanger used for naphtha cooling, employing Aspen HYSYS v14 and the Exchanger Design and Rating (EDR) module to simulate and optimize heat transfer characteristics. By varying tube length, baffle spacing, and flow rates, the study identifies configurations that enhance heat duty by up to 18% while maintaining acceptable pressure drops. The optimized design demonstrates improved temperature profiles, reduced fouling risk, and enhanced energy recovery, offering a scalable retrofit strategy for industrial heat exchangers.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"url":"https://zenodo.org/doi/10.5281/zenodo.17101057","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-11T16:12:55Z","registered":"2025-09-11T16:12:55Z","published":null,"updated":"2025-09-11T16:12:55Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}}}},{"id":"10.5281/zenodo.17101056","type":"dois","attributes":{"doi":"10.5281/zenodo.17101056","identifiers":[],"creators":[{"name":"Efemena, Noble Aggrey","nameType":"Personal","givenName":"Noble Aggrey","familyName":"Efemena","affiliation":["Department of Gas Refining and Petrochemical Engineering, University of Port Harcourt, Nigeria"],"nameIdentifiers":[]},{"name":"Muwarure, Peter Odiboroghene","nameType":"Personal","givenName":"Peter Odiboroghene","familyName":"Muwarure","affiliation":["Department of Chemical Engineering, University of Port Harcourt, Nigeria"],"nameIdentifiers":[]}],"titles":[{"title":"Thermal Performance Optimization of Shell and Tube Heat Exchangers Using Simulation Based Design Enhancements"}],"publisher":"IJRESM","container":{},"publicationYear":2025,"subjects":[],"contributors":[],"dates":[{"date":"2025-09-08","dateType":"Issued"}],"language":null,"types":{"ris":"JOUR","bibtex":"article","citeproc":"article-journal","schemaOrg":"ScholarlyArticle","resourceType":"","resourceTypeGeneral":"JournalArticle"},"relatedIdentifiers":[{"relationType":"HasVersion","relatedIdentifier":"10.5281/zenodo.17101057","relatedIdentifierType":"DOI"},{"relationType":"IsPartOf","relatedIdentifier":"2581-5792","resourceTypeGeneral":"Collection","relatedIdentifierType":"ISSN"}],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Shell-and-tube heat exchangers are critical components in petrochemical processing, where efficient thermal exchange directly impacts energy consumption and product quality. This study investigates the thermal performance of a legacy heat exchanger used for naphtha cooling, employing Aspen HYSYS v14 and the Exchanger Design and Rating (EDR) module to simulate and optimize heat transfer characteristics. By varying tube length, baffle spacing, and flow rates, the study identifies configurations that enhance heat duty by up to 18% while maintaining acceptable pressure drops. The optimized design demonstrates improved temperature profiles, reduced fouling risk, and enhanced energy recovery, offering a scalable retrofit strategy for industrial heat exchangers.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"url":"https://zenodo.org/doi/10.5281/zenodo.17101056","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":1,"versionOfCount":0,"created":"2025-09-11T16:12:55Z","registered":"2025-09-11T16:12:55Z","published":null,"updated":"2025-09-11T16:12:55Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}}}}],"meta":{"total":4,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=%22Aspen%20HYSYS%22%20V14\u0026page%5Bsize%5D=20"}}
